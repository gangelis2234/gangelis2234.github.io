<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Horizon Elevators Remote Monitoring — continuous lift telemetry, real-time fault detection and predictive maintenance."><meta name="theme-color" content="#050708"><title>Remote Monitoring | Horizon Elevators</title><link rel="icon" href="logo.svg" type="image/svg+xml"><style>
:root{--bg:#050708;--panel:#0b1112;--text:#f5f7f7;--muted:#a8afb0;--line:rgba(255,255,255,.10);--cyan:#09b8c4;--cyan2:#00d1dc;--max:1320px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.4;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:80px 80px}a{color:inherit;text-decoration:none}header{height:116px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 48px;position:sticky;top:0;z-index:10;background:rgba(5,7,8,.92);backdrop-filter:blur(16px)}.brand img{width:180px;height:88px;object-fit:contain}.nav{display:flex;align-items:center;gap:40px;color:#c8cccd}.nav a:hover,.nav .active{color:var(--cyan2)}.demo,.primary{background:var(--cyan);color:#031012;border-radius:999px;padding:14px 24px;font-weight:700}.menu{display:none;background:none;border:0}.menu span{display:block;width:25px;height:2px;background:#ddd;margin:5px}.section{max-width:var(--max);margin:auto;padding:105px 48px}.hero{padding-top:85px;display:grid;grid-template-columns:1.05fr .95fr;gap:80px;align-items:end;border-bottom:1px solid var(--line)}.eyebrow,.label{font:11px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.16em;color:#aeb5b6}.eyebrow{display:inline-flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:999px;padding:11px 16px;background:rgba(255,255,255,.025)}.pulse{width:9px;height:9px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 5px rgba(0,200,214,.08)}h1{font-size:clamp(58px,7vw,100px);line-height:1;letter-spacing:-.055em;margin:38px 0 28px}h1 span,h2 span{color:var(--cyan2)}.lead{font-size:21px;line-height:1.65;color:var(--muted);max-width:780px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stat{padding:25px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.018)}.stat b{display:block;font:11px ui-monospace,monospace;letter-spacing:.13em;color:#8f999a;margin-bottom:13px}.stat strong{font-size:28px}.stat p{color:var(--muted);margin:8px 0 0;font-size:14px}.block{display:grid;grid-template-columns:240px 1fr;gap:70px;border-bottom:1px solid var(--line)}h2{font-size:clamp(43px,5vw,72px);line-height:1.03;letter-spacing:-.045em;margin:0 0 28px}.copy>p{font-size:20px;color:var(--muted);max-width:900px}.features{display:grid;grid-template-columns:repeat(3,1fr);margin-top:45px;border-top:1px solid var(--line)}.feature{padding:27px 22px 30px 0;border-bottom:1px solid var(--line)}.feature:nth-child(3n+2),.feature:nth-child(3n+3){padding-left:22px;border-left:1px solid var(--line)}.feature b,.stepnum{font:11px ui-monospace,monospace;color:var(--cyan2);letter-spacing:.12em}.feature h3{font-size:20px;margin:17px 0 7px}.feature p{font-size:15px;color:var(--muted);margin:0}.outcomes{display:grid;grid-template-columns:240px 1fr;gap:70px}.outcome-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.outcome{padding:20px 0;border-bottom:1px solid var(--line);font-size:17px}.outcome span{color:var(--cyan2);font:11px ui-monospace,monospace;margin-right:15px}.steps{margin-top:48px;border-top:1px solid var(--line)}.step{display:grid;grid-template-columns:90px 1fr;gap:30px;padding:27px 0;border-bottom:1px solid var(--line)}.step h3{font-size:24px;margin:0 0 7px}.step p{margin:0;color:var(--muted);max-width:720px}.cta{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;background:linear-gradient(145deg,#0c1415,#080b0c);border:1px solid var(--line);border-radius:30px;padding:55px}.cta p{font-size:19px;color:var(--muted)}.actions{display:flex;gap:13px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:center;gap:13px;padding:14px 22px;border-radius:999px;font-weight:700}.ghost{border:1px solid var(--line);background:rgba(255,255,255,.02)}footer{max-width:var(--max);margin:auto;border-top:1px solid var(--line);padding:30px 48px 45px;display:flex;justify-content:space-between;align-items:center;color:#778080;font-size:13px}.footerbrand{display:flex;align-items:center;gap:16px}.footerbrand img{width:110px;height:54px;object-fit:contain}@media(max-width:1050px){header{padding:0 28px}.nav{gap:22px}.hero,.cta{grid-template-columns:1fr}.block,.outcomes{grid-template-columns:1fr;gap:25px}.features{grid-template-columns:repeat(2,1fr)}.feature:nth-child(3n+3){border-left:0;padding-left:0}.feature:nth-child(odd){padding-left:0}.feature:nth-child(even){border-left:1px solid var(--line);padding-left:22px}}@media(max-width:760px){header{height:82px;padding:0 20px}.brand img{width:145px;height:68px}.menu{display:block}.nav{position:absolute;left:15px;right:15px;top:75px;display:none;flex-direction:column;align-items:stretch;gap:0;background:#0a0e0f;border:1px solid var(--line);border-radius:18px;padding:10px}.nav.open{display:flex}.nav a{padding:14px 15px}.demo{text-align:center;margin:7px 0}.section{padding:75px 20px}.hero{padding-top:55px}.stats,.features,.outcome-grid{grid-template-columns:1fr}.feature:nth-child(even){border-left:0;padding-left:0}.feature{padding-left:0}.step{grid-template-columns:55px 1fr;gap:15px}.cta{padding:30px}footer{padding:28px 20px;display:block}footer>span{display:block;margin-top:15px}}
</style></head><body>
<header><a class="brand" href="index.html"><img src="logo.svg" alt="Horizon Elevators"></a><button class="menu" aria-label="Open navigation"><span></span><span></span><span></span></button><nav class="nav"><a href="index.html">Home</a><a class="active" href="remote-monitoring.html">Remote Monitoring</a><a href="index.html#services">Services</a><a href="index.html#about">About</a><a href="index.html#contact">Contact</a><a class="demo" href="index.html#contact">Request a demo</a></nav></header>
<main>
<section class="section hero"><div><div class="eyebrow"><span class="pulse"></span>CONTINUOUS 24 / 7 / 365</div><h1>Always-on intelligence for <span>every connected lift.</span></h1><p class="lead">Always-on telemetry from every connected lift, with fault detection, technician alerts and predictive maintenance insights.</p></div><div class="stats"><div class="stat"><b>CONTINUOUS</b><strong>24 / 7 / 365</strong><p>Always-on telemetry from every connected lift.</p></div><div class="stat"><b>IMMEDIATE</b><strong>&lt; 60 seconds</strong><p>From fault detection to technician alert.</p></div><div class="stat"><b>PREDICTIVE</b><strong>~ 62 day</strong><p>Average lead time on wear-based interventions.</p></div></div></section>
<section class="section block"><div class="label">WHAT IT DOES</div><div class="copy"><h2>Twelve capabilities. <span>One connected platform.</span></h2><p>Every feature is designed around one goal: keeping your lifts moving and giving you complete visibility over how they're performing.</p><div class="features"><article class="feature"><b>F01</b><h3>24/7 Monitoring</h3><p>Continuous oversight of every connected lift, day and night — no gaps, no downtime blind spots.</p></article><article class="feature"><b>F02</b><h3>Real-Time Fault Detection</h3><p>Anomalies are surfaced the moment they occur, not when a passenger picks up the phone.</p></article><article class="feature"><b>F03</b><h3>Instant Technician Alerts</h3><p>Our on-call service team is notified automatically with full fault context.</p></article><article class="feature"><b>F04</b><h3>Faster Response Times</h3><p>Technicians arrive briefed and equipped, cutting first-attempt fix time.</p></article><article class="feature"><b>F05</b><h3>Predictive Maintenance</h3><p>Trends across ride quality, door cycles and drive currents flag issues before failure.</p></article><article class="feature"><b>F06</b><h3>Reduced Downtime</h3><p>Early detection means most faults are resolved before they interrupt passenger service.</p></article><article class="feature"><b>F07</b><h3>Live Equipment Status</h3><p>Building managers see real-time operational status across every asset.</p></article><article class="feature"><b>F08</b><h3>Performance Reporting</h3><p>Detailed reports on faults, uptime, ride quality and maintenance history.</p></article><article class="feature"><b>F09</b><h3>Asset Insights</h3><p>Understand how each lift performs over time to plan smarter capital works.</p></article><article class="feature"><b>F10</b><h3>Improved Passenger Safety</h3><p>Rapid detection reduces the likelihood of entrapments and service disruptions.</p></article><article class="feature"><b>F11</b><h3>Better Communication</h3><p>Automated updates keep building managers informed on every incident.</p></article><article class="feature"><b>F12</b><h3>Future Ready</h3><p>Cloud-based platform built for smart buildings and connected facility ecosystems.</p></article></div></div></section>
<section class="section block"><div class="label">WHAT YOU GET</div><div class="copy"><h2>Features are the how. <span>These are the why.</span></h2><p>Remote Monitoring exists to deliver measurable outcomes to the people responsible for buildings — not to hand you another dashboard.</p><div class="outcome-grid"><div class="outcome"><span>01</span>Less downtime</div><div class="outcome"><span>02</span>Fewer unexpected breakdowns</div><div class="outcome"><span>03</span>Faster technician response</div><div class="outcome"><span>04</span>Better visibility</div><div class="outcome"><span>05</span>Improved safety</div><div class="outcome"><span>06</span>Reduced operational disruption</div><div class="outcome"><span>07</span>Longer equipment life</div><div class="outcome"><span>08</span>Greater confidence in lift performance</div><div class="outcome"><span>09</span>Better planning for future upgrades</div><div class="outcome"><span>10</span>Improved service quality</div></div></div></section>
<section class="section block"><div class="label">FLAGSHIP PLATFORM</div><div class="copy"><h2>The intelligent monitoring layer for <span>every lift in your portfolio.</span></h2><p>A cloud-connected system that continuously watches over lift performance — detecting faults the moment they appear, alerting the right technician instantly, and turning maintenance from reactive to predictive.</p><div class="steps"><article class="step"><div class="stepnum">01 / SENSE</div><div><h3>Sense</h3><p>Edge devices stream controller data continuously to the Horizon cloud.</p></div></article><article class="step"><div class="stepnum">02 / DETECT</div><div><h3>Detect</h3><p>Machine-assisted analysis flags any deviation from the lift's baseline profile.</p></div></article><article class="step"><div class="stepnum">03 / DISPATCH</div><div><h3>Dispatch</h3><p>The right technician is automatically alerted with full context.</p></div></article><article class="step"><div class="stepnum">04 / RESOLVE</div><div><h3>Resolve</h3><p>Fault data feeds trend analysis, informing the next preventative cycle.</p></div></article></div></div></section><section class="section"><div class="cta"><div><div class="label">SEE IT LIVE</div><h2>Book a <span>20-minute walkthrough.</span></h2><p>We'll show you the platform against a real lift fleet — and how it would apply to yours.</p></div><div class="actions"><a class="button primary" href="index.html#contact">Request a demo <span>→</span></a><a class="button ghost" href="index.html">Back to home</a></div></div></section></main>
<footer><div class="footerbrand"><img src="logo.svg" alt="Horizon Elevators"><span>Intelligent vertical transportation. Australian-owned. Engineered around reliability, safety, and real-time data.</span></div><span>© <span id="year"></span> Horizon Elevators</span></footer><script>const m=document.querySelector('.menu'),n=document.querySelector('.nav');m?.addEventListener('click',()=>n.classList.toggle('open'));document.getElementById('year').textContent=new Date().getFullYear();</script></body></html>
